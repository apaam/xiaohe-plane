server {
    listen 80;
    server_name plane.xiaohe.team;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name plane.xiaohe.team;

    # ssl_certificate     /etc/letsencrypt/live/plane.xiaohe.team/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/plane.xiaohe.team/privkey.pem;

    client_max_body_size 50m;

    # Root always enters SSO; /auth/xiaohe/start/ redirects authenticated users onward.
    location = / {
        return 302 /auth/xiaohe/start/?next=/research/;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
