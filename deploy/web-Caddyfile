{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting for static asset requests.
	# Plane's default is 300/min; a single first load can exceed it.
	rate_limit {
		zone static {
			key {client_ip}
			events 10000
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# Compress the large PDF-export CJK fonts on the wire. The browser inflates
	# them natively, so @react-pdf/fontkit still receives a plain TTF (JS-side
	# inflate of WOFF was the reason exports blocked for ~90s).
	encode zstd gzip {
		match {
			header Content-Type font/*
		}
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
