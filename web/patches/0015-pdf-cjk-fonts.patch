@@ -0,0 +1,86 @@
+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ *
+ * @react-pdf/textkit appends a visible hyphen whenever a line breaks at a
+ * hyphenation point. Pages split CJK runs per character so Chinese text wraps
+ * at all, and those breaks must not gain a hyphen. Latin hyphenation is left
+ * untouched. The library exposes no hook for this, hence the install-time
+ * patch; it fails loudly if the expected source shape changes on upgrade.
+ */
+
+const fs = require("node:fs");
+const path = require("node:path");
+
+const MARKER = "xiaohe-cjk-no-hyphen";
+const ORIGINAL = `            line = slice(start, end, attributedString);
+            line = insertGlyph(line.string.length, HYPHEN, line);`;
+const PATCHED = `            line = slice(start, end, attributedString);
+            // ${MARKER}: CJK line breaks are plain wraps, not hyphenation.
+            const code = line.string.charCodeAt(line.string.length - 1);
+            const isCJK =
+                (code >= 0x3000 && code <= 0x303f) ||
+                (code >= 0x3400 && code <= 0x4dbf) ||
+                (code >= 0x4e00 && code <= 0x9fff) ||
+                (code >= 0xf900 && code <= 0xfaff) ||
+                (code >= 0xff00 && code <= 0xffef);
+            if (!isCJK) line = insertGlyph(line.string.length, HYPHEN, line);`;
+
+// pnpm installs transitive dependencies into the virtual store; npm hoists them
+// or nests them under the dependent package. Look in all of those places.
+function textkitSources() {
+  const roots = new Set();
+  for (const start of [process.cwd(), __dirname]) {
+    let dir = path.resolve(start);
+    while (true) {
+      roots.add(dir);
+      const parent = path.dirname(dir);
+      if (parent === dir) break;
+      dir = parent;
+    }
+  }
+  const candidates = [];
+  for (const root of roots) {
+    for (const nodeModules of [path.join(root, "node_modules"), path.join(root, "apps", "web", "node_modules")]) {
+      candidates.push(path.join(nodeModules, "@react-pdf", "textkit", "lib", "textkit.js"));
+      candidates.push(
+        path.join(nodeModules, "@react-pdf", "renderer", "node_modules", "@react-pdf", "textkit", "lib", "textkit.js"),
+      );
+      let entries = [];
+      try {
+        entries = fs.readdirSync(path.join(nodeModules, ".pnpm"));
+      } catch {
+        // Not a pnpm store at this level.
+      }
+      for (const entry of entries) {
+        if (entry.startsWith("@react-pdf+textkit@")) {
+          candidates.push(
+            path.join(nodeModules, ".pnpm", entry, "node_modules", "@react-pdf", "textkit", "lib", "textkit.js"),
+          );
+        }
+      }
+    }
+  }
+  return candidates;
+}
+
+const sources = textkitSources()
+  .filter((file) => fs.existsSync(file))
+  .filter((file, index, files) => files.indexOf(file) === index);
+
+if (sources.length === 0) {
+  console.error("patch-react-pdf-cjk: cannot locate @react-pdf/textkit");
+  process.exit(1);
+}
+
+for (const source of sources) {
+  const content = fs.readFileSync(source, "utf8");
+  if (content.includes(MARKER)) continue;
+  if (!content.includes(ORIGINAL)) {
+    console.error(`patch-react-pdf-cjk: expected snippet not found in ${source}`);
+    process.exit(1);
+  }
+  fs.writeFileSync(source, content.replace(ORIGINAL, PATCHED));
+  console.log(`patch-react-pdf-cjk: patched ${source}`);
+}
