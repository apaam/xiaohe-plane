diff --git a/apps/web/postinstall/patch-react-pdf-cjk.cjs b/apps/web/postinstall/patch-react-pdf-cjk.cjs
new file mode 100644
index 0000000..5fd3349
--- /dev/null
+++ b/apps/web/postinstall/patch-react-pdf-cjk.cjs
@@ -0,0 +1,61 @@
+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ *
+ * @react-pdf/textkit appends a visible hyphen whenever a line breaks at a
+ * hyphenation point. Pages split CJK runs per character so Chinese text wraps
+ * at all, and those breaks must not gain a hyphen. Latin hyphenation is left
+ * untouched. The library exposes no hook for this, hence the install-time
+ * patch; it fails loudly if the expected source shape changes on upgrade.
+ */
+
+const fs = require("node:fs");
+const path = require("node:path");
+
+const MARKER = "xiaohe-cjk-no-hyphen";
+const ORIGINAL = `            line = slice(start, end, attributedString);
+            line = insertGlyph(line.string.length, HYPHEN, line);`;
+const PATCHED = `            line = slice(start, end, attributedString);
+            // ${MARKER}: CJK line breaks are plain wraps, not hyphenation.
+            const code = line.string.charCodeAt(line.string.length - 1);
+            const isCJK =
+                (code >= 0x3000 && code <= 0x303f) ||
+                (code >= 0x3400 && code <= 0x4dbf) ||
+                (code >= 0x4e00 && code <= 0x9fff) ||
+                (code >= 0xf900 && code <= 0xfaff) ||
+                (code >= 0xff00 && code <= 0xffef);
+            if (!isCJK) line = insertGlyph(line.string.length, HYPHEN, line);`;
+
+function findTextkitSource() {
+  const candidates = [];
+  try {
+    candidates.push(require.resolve("@react-pdf/textkit"));
+  } catch {
+    // Transitive dependency is not linked in the workspace root with pnpm.
+  }
+  try {
+    const renderer = require.resolve("@react-pdf/renderer/package.json");
+    candidates.push(path.resolve(path.dirname(renderer), "../textkit/lib/textkit.js"));
+  } catch {
+    // Renderer missing means the install is incomplete; the caller reports it.
+  }
+  return candidates.find((file) => fs.existsSync(file));
+}
+
+const source = findTextkitSource();
+if (!source) {
+  console.error("patch-react-pdf-cjk: cannot locate @react-pdf/textkit");
+  process.exit(1);
+}
+
+const content = fs.readFileSync(source, "utf8");
+if (content.includes(MARKER)) {
+  process.exit(0);
+}
+if (!content.includes(ORIGINAL)) {
+  console.error(`patch-react-pdf-cjk: expected snippet not found in ${source}`);
+  process.exit(1);
+}
+fs.writeFileSync(source, content.replace(ORIGINAL, PATCHED));
+console.log(`patch-react-pdf-cjk: patched ${source}`);
