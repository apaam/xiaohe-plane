+
+/* Xiaohe patch 0030: keep the Pages sub-header tab pills vertically centred with
+   the search/sort/filter buttons while the active underline stays on the bottom
+   border of the 40px row. The stock underline tab reserves 8px between label and
+   bar, which cannot fit in 40px, so tighten it to 2px, shift the strip down 6px,
+   and pull the tracking indicator up to the new bar position. */
+.pages-header-tabs {
+  padding-top: 6px;
+}
+.pages-header-tabs [role="tab"] {
+  gap: 2px;
+}
+.pages-header-tabs [role="tablist"] > span {
+  top: calc(var(--active-tab-top) + 30px);
+}
