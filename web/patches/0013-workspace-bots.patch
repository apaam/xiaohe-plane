@@ -0,0 +1,384 @@
+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import { useCallback, useEffect, useState } from "react";
+import { observer } from "mobx-react";
+import axios from "axios";
+// plane imports
+import { EUserPermissions, EUserPermissionsLevel } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { setToast } from "@plane/blocks/toast";
+import { Button } from "@makeplane/propel/components/button";
+// components
+import { NotAuthorizedView } from "@/components/auth-screens/not-authorized-view";
+import { PageHead } from "@/components/core/page-title";
+import { SettingsContentWrapper } from "@/components/settings/content-wrapper";
+import { SettingsHeading } from "@/components/settings/heading";
+// hooks
+import { useUserPermissions } from "@/hooks/store/user";
+import { useWorkspace } from "@/hooks/store/use-workspace";
+// local imports
+import type { Route } from "./+types/page";
+import { BotsWorkspaceSettingsHeader } from "./header";
+
+type BotProject = { id: string; identifier: string; name: string };
+type Bot = {
+  id: string;
+  email: string;
+  display_name: string;
+  is_active: boolean;
+  token_active: boolean;
+  last_used: string | null;
+  owner: { id: string; display_name: string; email: string } | null;
+  projects: BotProject[];
+};
+type Project = { id: string; identifier: string; name: string };
+type Member = {
+  id: string;
+  member: { id: string; display_name: string; email: string; is_bot?: boolean };
+  is_active?: boolean;
+};
+
+const api = axios.create({ withCredentials: true });
+
+function BotsSettingsPage({ params }: Route.ComponentProps) {
+  const { workspaceSlug } = params;
+  const { t } = useTranslation();
+  const { currentWorkspace } = useWorkspace();
+  const { workspaceUserInfo, allowPermissions } = useUserPermissions();
+  const isAdmin = allowPermissions([EUserPermissions.ADMIN], EUserPermissionsLevel.WORKSPACE);
+
+  const [bots, setBots] = useState<Bot[] | null>(null);
+  const [projects, setProjects] = useState<Project[]>([]);
+  const [members, setMembers] = useState<Member[]>([]);
+  const [ownerId, setOwnerId] = useState("");
+  const [showForm, setShowForm] = useState(false);
+  const [name, setName] = useState("");
+  const [selected, setSelected] = useState<string[]>([]);
+  const [token, setToken] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [ownerDraft, setOwnerDraft] = useState<Record<string, string>>({});
+
+  const load = useCallback(async () => {
+    const [botsRes, projectsRes, membersRes] = await Promise.all([
+      api.get(`/auth/xiaohe/bots/${workspaceSlug}/`),
+      api.get(`/api/workspaces/${workspaceSlug}/projects/`),
+      api.get(`/api/workspaces/${workspaceSlug}/members/`),
+    ]);
+    setBots(botsRes.data?.bots ?? []);
+    setProjects(Array.isArray(projectsRes.data) ? projectsRes.data : projectsRes.data?.results ?? []);
+    const memberRows = Array.isArray(membersRes.data) ? membersRes.data : membersRes.data?.results ?? [];
+    setMembers(
+      memberRows.filter(
+        (row: Member) =>
+          row.is_active !== false &&
+          row.member.is_bot !== true &&
+          !String(row.member.email).endsWith("-bot@xiaohe.local")
+      )
+    );
+  }, [workspaceSlug]);
+
+  useEffect(() => {
+    if (!isAdmin) return;
+    load().catch((error) => {
+      setBots([]);
+      setToast({
+        type: "error",
+        title: t("workspace_settings.bots.failed"),
+        message: String(error?.response?.data?.error ?? error?.message ?? ""),
+      });
+    });
+  }, [isAdmin, load]); // eslint-disable-line react-hooks/exhaustive-deps -- @plane/i18n returns a fresh t on every render, so t in deps loops the effect
+
+  const createBot = async () => {
+    if (!name.trim()) return;
+    setBusy(true);
+    try {
+      const res = await api.post(`/auth/xiaohe/bots/${workspaceSlug}/`, {
+        name: name.trim(),
+        project_ids: selected,
+        ...(ownerId ? { owner_id: ownerId } : {}),
+      });
+      setToken(res.data?.token ?? null);
+      setShowForm(false);
+      setName("");
+      setSelected([]);
+      setOwnerId("");
+      await load();
+      setToast({ type: "success", title: t("workspace_settings.bots.created") });
+    } catch (error: any) {
+      setToast({
+        type: "error",
+        title: t("workspace_settings.bots.failed"),
+        message: String(error?.response?.data?.error ?? error?.message ?? ""),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const runAction = async (
+    bot: Bot,
+    action: "rotate" | "disable" | "enable" | "owner",
+    ownerId?: string
+  ) => {
+    setBusy(true);
+    try {
+      const res = await api.post(
+        `/auth/xiaohe/bots/${workspaceSlug}/${bot.id}/${action}/`,
+        action === "owner" ? { owner_id: ownerId } : undefined
+      );
+      if (action === "rotate") setToken(res.data?.token ?? null);
+      await load();
+      if (action === "owner") {
+        setOwnerDraft((current) => {
+          const next = { ...current };
+          delete next[bot.id];
+          return next;
+        });
+        setToast({ type: "success", title: t("workspace_settings.bots.owner_saved") });
+      }
+      if (action === "rotate") {
+        setToast({ type: "success", title: t("workspace_settings.bots.rotated") });
+      }
+    } catch (error: any) {
+      setToast({
+        type: "error",
+        title: t("workspace_settings.bots.failed"),
+        message: String(error?.response?.data?.error ?? error?.message ?? ""),
+      });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const copyToken = async () => {
+    if (!token) return;
+    await navigator.clipboard.writeText(token);
+    setToast({ type: "success", title: t("workspace_settings.bots.copied") });
+  };
+
+  const pageTitle = currentWorkspace?.name
+    ? `${currentWorkspace.name} - ${t("workspace_settings.bots.title")}`
+    : undefined;
+
+  if (workspaceUserInfo && !isAdmin) {
+    return <NotAuthorizedView section="settings" className="h-auto" />;
+  }
+
+  return (
+    <SettingsContentWrapper header={<BotsWorkspaceSettingsHeader />}>
+      <PageHead title={pageTitle} />
+      <div className="flex w-full flex-col gap-4">
+        <SettingsHeading
+          title={t("workspace_settings.bots.title")}
+          description={t("workspace_settings.bots.description")}
+          control={
+            <Button
+              variant="primary"
+              size="md"
+              stretch="auto"
+              label={t("workspace_settings.bots.create")}
+              onClick={() => setShowForm(true)}
+            />
+          }
+        />
+
+        {token && (
+          <div className="rounded-lg border border-subtle bg-surface-1 p-4">
+            <p className="text-body-sm-medium text-primary">
+              {t("workspace_settings.bots.token_title")}
+            </p>
+            <p className="mt-1 text-body-xs-regular text-tertiary">
+              {t("workspace_settings.bots.token_hint")}
+            </p>
+            <div className="mt-3 flex items-center gap-2">
+              <code className="flex-1 overflow-x-auto rounded border border-subtle bg-surface-2 px-3 py-2 text-body-xs-regular text-primary">
+                {token}
+              </code>
+              <Button variant="secondary" size="md" stretch="auto" label={t("workspace_settings.bots.copy")} onClick={copyToken} />
+            </div>
+          </div>
+        )}
+
+        {showForm && (
+          <div className="rounded-lg border border-subtle bg-surface-1 p-4">
+            <label className="text-body-sm-medium text-primary" htmlFor="bot-name">
+              {t("workspace_settings.bots.name")}
+            </label>
+            <input
+              id="bot-name"
+              className="mt-2 w-full rounded border border-subtle bg-surface-2 px-3 py-2 text-body-sm-regular text-primary"
+              placeholder={t("workspace_settings.bots.name_placeholder")}
+              value={name}
+              onChange={(event) => setName(event.target.value)}
+            />
+            <label className="mt-3 block text-body-sm-medium text-primary" htmlFor="bot-owner">
+              {t("workspace_settings.bots.owner")}
+            </label>
+            <select
+              id="bot-owner"
+              className="mt-2 w-full rounded border border-subtle bg-surface-2 px-3 py-2 text-body-sm-regular text-primary"
+              value={ownerId}
+              onChange={(event) => setOwnerId(event.target.value)}
+            >
+              <option value="">{t("workspace_settings.bots.owner_default")}</option>
+              {members.map((row) => (
+                <option key={row.member.id} value={row.member.id}>
+                  {row.member.display_name || row.member.email}
+                </option>
+              ))}
+            </select>
+            <p className="mt-2 text-body-xs-regular text-tertiary">
+              {t("workspace_settings.bots.projects")}
+            </p>
+            <div className="mt-2 grid gap-1">
+              {projects.map((project) => (
+                <label key={project.id} className="flex items-center gap-2 text-body-sm-regular text-primary">
+                  <input
+                    type="checkbox"
+                    checked={selected.includes(project.id)}
+                    onChange={(event) =>
+                      setSelected((current) =>
+                        event.target.checked
+                          ? [...current, project.id]
+                          : current.filter((id) => id !== project.id)
+                      )
+                    }
+                  />
+                  {project.identifier} · {project.name}
+                </label>
+              ))}
+            </div>
+            <div className="mt-4 flex items-center gap-2">
+              <Button
+                variant="primary"
+                size="md"
+                stretch="auto"
+                label={t("workspace_settings.bots.submit")}
+                onClick={createBot}
+                disabled={busy || !name.trim()}
+              />
+              <Button
+                variant="secondary"
+                size="md"
+                stretch="auto"
+                label={t("workspace_settings.bots.cancel")}
+                onClick={() => setShowForm(false)}
+              />
+            </div>
+          </div>
+        )}
+
+        {bots === null ? (
+          <p className="text-body-sm-regular text-tertiary">Loading…</p>
+        ) : bots.length === 0 ? (
+          <p className="text-body-sm-regular text-tertiary">
+            {t("workspace_settings.bots.empty")}
+          </p>
+        ) : (
+          <div className="divide-y divide-subtle rounded-lg border border-subtle bg-surface-1">
+            {bots.map((bot) => (
+              <div key={bot.id} className="flex flex-col gap-3 p-4 md:flex-row md:items-center md:justify-between">
+                <div className="flex flex-col gap-1">
+                  <div className="flex items-center gap-2">
+                    <span className="text-body-sm-medium text-primary">{bot.display_name}</span>
+                    <span className="text-body-xs-regular text-tertiary">{bot.email}</span>
+                    {isAdmin ? (
+                      <div className="flex flex-wrap items-center gap-2 text-body-xs-regular text-tertiary">
+                        {t("workspace_settings.bots.owner")}:
+                        <select
+                          className="rounded border border-subtle bg-surface-2 px-2 py-1 text-body-xs-regular text-primary"
+                          value={ownerDraft[bot.id] ?? bot.owner?.id ?? ""}
+                          onChange={(event) =>
+                            setOwnerDraft((current) => ({ ...current, [bot.id]: event.target.value }))
+                          }
+                          disabled={busy}
+                          aria-label={t("workspace_settings.bots.owner")}
+                        >
+                          <option value="">{t("workspace_settings.bots.owner_unset")}</option>
+                          {members.map((row) => (
+                            <option key={row.member.id} value={row.member.id}>
+                              {row.member.display_name || row.member.email}
+                            </option>
+                          ))}
+                          {bot.owner && !members.some((row) => row.member.id === bot.owner?.id) && (
+                            <option value={bot.owner.id}>{bot.owner.display_name || bot.owner.email}</option>
+                          )}
+                        </select>
+                        <Button
+                          variant="secondary"
+                          size="md"
+                          stretch="auto"
+                          label={t("workspace_settings.bots.save_owner")}
+                          onClick={() =>
+                            runAction(bot, "owner", ownerDraft[bot.id] ?? bot.owner?.id ?? "")
+                          }
+                          disabled={
+                            busy || (ownerDraft[bot.id] ?? bot.owner?.id ?? "") === (bot.owner?.id ?? "")
+                          }
+                        />
+                      </div>
+                    ) : (
+                      <span className="text-body-xs-regular text-tertiary">
+                        {t("workspace_settings.bots.owner")}:{" "}
+                        {bot.owner?.display_name ?? t("workspace_settings.bots.owner_unset")}
+                      </span>
+                    )}
+                    <span
+                      className={
+                        bot.is_active
+                          ? "rounded bg-success-subtle px-1.5 py-0.5 text-body-xs-medium text-success-primary"
+                          : "rounded bg-surface-2 px-1.5 py-0.5 text-body-xs-medium text-tertiary"
+                      }
+                    >
+                      {bot.is_active
+                        ? t("workspace_settings.bots.active")
+                        : t("workspace_settings.bots.disabled")}
+                    </span>
+                  </div>
+                  <span className="text-body-xs-regular text-tertiary">
+                    {bot.projects.length > 0
+                      ? bot.projects.map((project) => `${project.identifier} · ${project.name}`).join(", ")
+                      : t("workspace_settings.bots.projects") + ": —"}
+                  </span>
+                  <span className="text-body-xs-regular text-tertiary">
+                    {t("workspace_settings.bots.last_used")}:{" "}
+                    {bot.last_used ?? t("workspace_settings.bots.never")}
+                  </span>
+                </div>
+                <div className="flex items-center gap-2">
+                  <Button
+                    variant="secondary"
+                    size="md"
+                    stretch="auto"
+                    label={t("workspace_settings.bots.rotate")}
+                    onClick={() => runAction(bot, "rotate")}
+                    disabled={busy}
+                  />
+                  <Button
+                    variant="secondary"
+                    size="md"
+                    stretch="auto"
+                    label={
+                      bot.is_active
+                        ? t("workspace_settings.bots.disable")
+                        : t("workspace_settings.bots.enable")
+                    }
+                    onClick={() => runAction(bot, bot.is_active ? "disable" : "enable")}
+                    disabled={busy}
+                  />
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </SettingsContentWrapper>
+  );
+}
+
+export default observer(BotsSettingsPage);
