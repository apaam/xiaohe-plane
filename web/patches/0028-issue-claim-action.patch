+import { useState } from "react";
+import { observer } from "mobx-react";
+// plane imports
+import { EUserPermissions, EUserPermissionsLevel } from "@plane/constants";
+import { useTranslation } from "@plane/i18n";
+import { UserPlusOutline } from "@makeplane/propel/icons";
+import { Button } from "@makeplane/propel/components/button";
+import { Icon } from "@makeplane/propel/components/icon";
+import { setToast } from "@plane/blocks/toast";
+import type { TIssue } from "@plane/types";
+// hooks
+import { useIssueDetail } from "@/hooks/store/use-issue-detail";
+import { useUser, useUserPermissions } from "@/hooks/store/user";
+
+type Props = {
+  workspaceSlug: string;
+  projectId: string;
+  issue: TIssue;
+  readOnly?: boolean;
+};
+
+/**
+ * One-click self-claim: assigns an unassigned work item to the current user.
+ * Members claim work themselves instead of an admin bulk-assigning it.
+ */
+export const IssueClaimAction = observer(function IssueClaimAction(props: Props) {
+  const { workspaceSlug, projectId, issue, readOnly = false } = props;
+  const { t } = useTranslation();
+  // states
+  const [isClaiming, setIsClaiming] = useState(false);
+  // store hooks
+  const { data: currentUser } = useUser();
+  const { allowPermissions } = useUserPermissions();
+  const { updateIssue } = useIssueDetail();
+  // auth: claiming = assigning to self, so it needs issue edit permission on the project
+  const isEditingAllowed =
+    allowPermissions(
+      [EUserPermissions.ADMIN, EUserPermissions.MEMBER],
+      EUserPermissionsLevel.PROJECT,
+      workspaceSlug,
+      projectId
+    ) &&
+    !readOnly &&
+    !issue.archived_at;
+  // only unassigned work items can be claimed
+  const canClaim = !!currentUser && isEditingAllowed && (issue.assignee_ids?.length ?? 0) === 0;
+
+  if (!canClaim) return null;
+
+  const handleClaim = async (e: React.MouseEvent<HTMLButtonElement>) => {
+    e.preventDefault();
+    e.stopPropagation();
+    if (!currentUser || isClaiming) return;
+    setIsClaiming(true);
+    try {
+      await updateIssue(workspaceSlug, projectId, issue.id, { assignee_ids: [currentUser.id] });
+      setToast({
+        type: "success",
+        title: t("issue.claim.success.title"),
+        message: t("issue.claim.success.message"),
+      });
+    } catch (_error) {
+      setToast({
+        type: "error",
+        title: t("toast.error"),
+        message: t("issue.claim.failed.message"),
+      });
+    } finally {
+      setIsClaiming(false);
+    }
+  };
+
+  return (
+    <Button
+      size="sm"
+      variant="secondary"
+      onClick={handleClaim}
+      loading={isClaiming}
+      icon={<Icon icon={UserPlusOutline} />}
+      label={t("issue.claim.label")}
+    />
+  );
+});
