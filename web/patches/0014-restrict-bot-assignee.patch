  * "Suspended" badge, as the legacy CE dropdown did (a selected one stays enabled so it can still be
  * removed, and the trigger keeps showing it).
  */
+const restrictedBotsCache = new Map<string, Promise<Set<string>>>();
+
+// Bots the current user may not assign (not its owner and not a workspace admin).
+function fetchRestrictedBotIds(slug: string): Promise<Set<string>> {
+  const cached = restrictedBotsCache.get(slug);
+  if (cached) return cached;
+  const request = axios
+    .get(`/auth/xiaohe/bots/${slug}/assignable/`, { withCredentials: true })
+    .then((response) => {
+      const rows = (response.data?.bots ?? []) as { id: string; can_assign: boolean }[];
+      return new Set(rows.filter((row) => !row.can_assign).map((row) => row.id));
+    })
+    .catch(() => new Set<string>());
+  restrictedBotsCache.set(slug, request);
+  return request;
+}
