@@ -0,0 +1,77 @@
+/**
+ * Copyright (c) 2023-present Plane Software, Inc. and contributors
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * See the LICENSE file for details.
+ */
+
+import { useEffect, useState } from "react";
+import { Button } from "@makeplane/propel/components/button";
+
+import { XIAOHE_BUILD_ID } from "@/xiaohe-build";
+
+/**
+ * Compares the build this bundle was compiled from against the build the
+ * server is serving now.
+ *
+ * A tab that stays open across a deploy keeps running the old code — including
+ * any bug that old code has. This offers a reload instead of forcing one, so a
+ * half-written work item is never thrown away.
+ */
+export function VersionWatcher() {
+  const [stale, setStale] = useState(false);
+
+  useEffect(() => {
+    if (typeof window === "undefined") return;
+
+    let alive = true;
+    const check = async () => {
+      try {
+        const response = await fetch("/version.json", { cache: "no-store" });
+        if (!response.ok) return;
+        const data = (await response.json()) as { build_id?: string };
+        if (alive && data.build_id && XIAOHE_BUILD_ID && data.build_id !== XIAOHE_BUILD_ID) {
+          setStale(true);
+        }
+      } catch {
+        // Offline, or a proxy blocking the file: keep running the current build.
+      }
+    };
+
+    check();
+    const timer = window.setInterval(check, 60_000);
+    const onVisibility = () => {
+      if (!document.hidden) check();
+    };
+    document.addEventListener("visibilitychange", onVisibility);
+    return () => {
+      alive = false;
+      window.clearInterval(timer);
+      document.removeEventListener("visibilitychange", onVisibility);
+    };
+  }, []);
+
+  if (!stale) return null;
+
+  return (
+    <div className="fixed inset-x-0 bottom-6 z-[100] flex justify-center px-4">
+      <div className="flex items-center gap-3 rounded-lg border border-subtle bg-surface-1 px-4 py-2 text-body-sm-regular text-primary shadow-lg">
+        <span>有新版本，点击刷新</span>
+        <Button
+          variant="primary"
+          size="md"
+          stretch="auto"
+          label="刷新"
+          onClick={() => window.location.reload()}
+        />
+        <button
+          type="button"
+          aria-label="关闭"
+          className="text-tertiary hover:text-primary"
+          onClick={() => setStale(false)}
+        >
+          ✕
+        </button>
+      </div>
+    </div>
+  );
+}
