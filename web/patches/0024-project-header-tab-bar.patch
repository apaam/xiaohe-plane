diff --git a/apps/web/styles/globals.css b/apps/web/styles/globals.css
index c048726..88ce508 100644
--- a/apps/web/styles/globals.css
+++ b/apps/web/styles/globals.css
@@ -102,3 +102,22 @@
   max-height: calc(min(var(--available-height), 24rem) - 2px);
   overflow: hidden;
 }
+
+/* Xiaohe patch 0021: project header tab strip.
+   Upstream's underline tabs stack label + 8px gap + 3px bar and the list is
+   top-aligned (items-start), so inside the 40px bar the label pill is glued to
+   the top edge and the active bar lands on the border. Center the pill in the
+   bar and pin the bar — and the shared active-tab indicator — to the bar bottom. */
+.project-header-tabs {
+  height: 2.5rem; /* match the h-10 project header bar */
+  align-items: center;
+}
+.project-header-tab-item .project-header-tab > span:last-child {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  left: 0;
+}
+.project-header-tabs > span:last-child {
+  top: calc(100% - 3px);
+}
